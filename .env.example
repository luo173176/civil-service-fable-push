# ============================================================
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交）。
# 在 GitHub Actions 中使用时，请把同样的值配置到仓库 Secrets。
# ============================================================

# ---------- LLM（OpenAI 兼容接口） ----------
# 不配置 LLM_API_KEY 时，程序自动改用 stories/pregenerated/ 预生成库按顺序推送
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# 常见组合示例：
#   OpenAI:    https://api.openai.com/v1        + gpt-4o-mini
#   DeepSeek:  https://api.deepseek.com         + deepseek-chat
#   智谱GLM:   https://open.bigmodel.cn/api/paas/v4 + glm-4-flash
#   月之暗面:  https://api.moonshot.cn/v1       + moonshot-v1-32k
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=8000
LLM_TIMEOUT=300
LLM_MAX_RETRIES=3

# ---------- 推送档期（仅作用于 GitHub 定时触发；手动运行不受限） ----------
# 北京时间、逗号分隔的推送档期，默认 12:00（每天中午一次）
SLOT_TIMES=12:00
# 档期窗口（分钟）：schedule 运行落在档期后多少分钟内才算命中该档
SLOT_WINDOW_MINUTES=120

# ---------- 推送渠道 ----------
# 逗号分隔可同时多渠道，可选值：
#   serverchan / pushplus / bark / telegram / wecom / dingtalk / feishu / mail
PUSH_CHANNEL=serverchan

# Server酱（sct.ftqq.com）：填 SendKey
SERVERCHAN_SENDKEY=

# PushPlus（pushplus.plus）：填 token
PUSHPLUS_TOKEN=

# Bark（iOS）：填形如 https://api.day.app/你的DeviceKey
# 注意：Bark 只推送前 1000 字摘要，完整内容请看仓库
BARK_URL=

# Telegram：找 @BotFather 建 Bot 拿 token；chat_id 可问 @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 企业微信群机器人：群设置-群机器人-添加，复制 Webhook 地址
WECOM_WEBHOOK=

# 钉钉群机器人：安全设置请选"自定义关键词"（推荐关键词：寓言），暂不支持加签
DINGTALK_WEBHOOK=

# 飞书群机器人：群设置-群机器人-自定义机器人，复制 Webhook 地址
FEISHU_WEBHOOK=

# SMTP 邮件：465 端口走 SSL，587/25 走 STARTTLS
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@qq.com
SMTP_PASS=你的授权码（不是登录密码）
MAIL_TO=receiver@example.com
